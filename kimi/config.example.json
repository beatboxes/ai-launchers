{
  "name": "kimi-wrap",
  "version": "0.2.0",
  "description": "Moonshot Kimi models as the brain of Claude Code (official Anthropic-compatible endpoint, via the gateway)",
  "mode": "gateway",
  "transports": [
    {
      "id": "kimi",
      "preset": "kimi",
      "auth": "api-key",
      "env": ["MOONSHOT_API_KEY", "KIMI_API_KEY"],
      "op_ref": "",
      "default_model": "kimi-k3",
      "background_model": "kimi-k2.7-code",
      "list_url": "https://api.moonshot.ai/v1/models"
    }
  ]
}
