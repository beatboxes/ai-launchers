{
  "name": "grok-wrap",
  "version": "0.2.0",
  "description": "xAI Grok models as the brain of Claude Code",
  "mode": "gateway",
  "transports": [
    {
      "id": "xai",
      "preset": "xai",
      "auth": "api-key",
      "env": ["XAI_API_KEY"],
      "op_ref": "",
      "default_model": "grok-4.7",
      "background_model": "grok-4.20-0309-non-reasoning"
    },
    {
      "id": "grok",
      "preset": "grok",
      "auth": "login",
      "default_model": "grok-4.7",
      "background_model": "grok-4.20-0309-non-reasoning",
      "setup": "run `grok login` (Grok Build CLI; credentials in ~/.grok/auth.json)"
    }
  ]
}
