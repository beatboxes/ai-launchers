{
  "name": "deepseek-wrap",
  "version": "0.2.0",
  "description": "DeepSeek models as the brain of Claude Code (official Anthropic-compatible endpoint, via the gateway)",
  "mode": "gateway",
  "transports": [
    {
      "id": "deepseek",
      "preset": "deepseek",
      "auth": "api-key",
      "env": ["DEEPSEEK_API_KEY"],
      "op_ref": "",
      "default_model": "deepseek-v4-pro",
      "background_model": "deepseek-v4-flash",
      "list_url": "https://api.deepseek.com/models",
      "env_extra": {
        "CLAUDE_CODE_EFFORT_LEVEL": "max"
      }
    }
  ]
}
